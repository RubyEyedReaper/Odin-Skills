{
  "goal": "Choose the primary database for a SaaS product handling 10k users and complex relational queries",
  "reversibility": "one-way",
  "constraints": [
    {"id": "open-source", "description": "Must be open-source or have a free tier suitable for MVP"},
    {"id": "managed-cloud", "description": "Must have a managed cloud offering (AWS/GCP/Azure)"}
  ],
  "options": [
    {
      "id": "postgres",
      "label": "PostgreSQL",
      "description": "Battle-tested relational DB with rich feature set",
      "constraint_results": {"open-source": true, "managed-cloud": true}
    },
    {
      "id": "mysql",
      "label": "MySQL",
      "description": "Widely used relational DB, strong ecosystem",
      "constraint_results": {"open-source": true, "managed-cloud": true}
    },
    {
      "id": "mongodb",
      "label": "MongoDB",
      "description": "Document-oriented NoSQL, flexible schema",
      "constraint_results": {"open-source": true, "managed-cloud": true}
    },
    {
      "id": "cockroachdb",
      "label": "CockroachDB",
      "description": "Distributed SQL, Postgres-compatible",
      "constraint_results": {"open-source": true, "managed-cloud": true}
    }
  ],
  "criteria": [
    {
      "id": "relational-fit",
      "label": "Relational Query Fit",
      "weight": 35,
      "direction": "higher-is-better",
      "description": "How well the DB supports complex joins and relational data models"
    },
    {
      "id": "ops-complexity",
      "label": "Operational Complexity",
      "weight": 20,
      "direction": "lower-is-better",
      "description": "Effort to operate, tune, and maintain in production"
