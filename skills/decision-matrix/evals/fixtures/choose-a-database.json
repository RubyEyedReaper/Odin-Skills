    {
      "id": "scalability",
      "label": "Horizontal Scalability",
      "weight": 15,
      "direction": "higher-is-better",
      "description": "Ability to scale out as data and traffic grow"
    },
    {
      "id": "cost",
      "label": "Managed Service Cost",
      "weight": 10,
      "direction": "lower-is-better",
      "description": "Monthly cost of managed cloud hosting at MVP scale"
    }
  ],
