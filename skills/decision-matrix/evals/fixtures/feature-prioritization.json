{
  "goal": "Prioritize the next feature to build for Q3: pick the single highest-impact option for a B2B SaaS",
  "reversibility": "two-way",
  "constraints": [
    {"id": "fits-in-sprint", "description": "Must be completable within a 2-week sprint by one engineer"},
    {"id": "no-new-infra", "description": "Must not require new infrastructure provisioning"}
  ],
  "options": [
    {
      "id": "csv-export",
      "label": "CSV Export",
      "description": "Allow users to export any data table as CSV",
      "constraint_results": {"fits-in-sprint": true, "no-new-infra": true}
    },
    {
      "id": "bulk-actions",
      "label": "Bulk Actions",
      "description": "Select multiple rows and apply actions (delete, tag, archive) at once",
      "constraint_results": {"fits-in-sprint": true, "no-new-infra": true}
    },
    {
      "id": "audit-log",
      "label": "Audit Log",
      "description": "Immutable log of all user actions for compliance",
      "constraint_results": {"fits-in-sprint": false, "no-new-infra": false}
    },
    {
      "id": "saved-filters",
      "label": "Saved Filters",
      "description": "Users can save and reuse search/filter combinations",
      "constraint_results": {"fits-in-sprint": true, "no-new-infra": true}
    }
  ],
  "criteria": [
    {
      "id": "reach",
      "label": "Reach (users/quarter)",
      "weight": 25,
      "direction": "higher-is-better",
      "description": "Number of users the feature will affect per quarter (raw count)"
    },
    {
      "id": "impact",
      "label": "Impact (1-3 scale)",
      "weight": 25,
      "direction": "higher-is-better",
      "description": "Impact per user: 0.25=minimal, 0.5=low, 1=medium, 2=high, 3=massive"
    },
    {
      "id": "confidence",
      "label": "Confidence (0-1)",
      "weight": 25,
      "direction": "higher-is-better",
      "description": "Confidence in the reach and impact estimates (0-1 scale)"
    },
    {
      "id": "effort",
      "label": "Effort (person-weeks)",
      "weight": 25,
      "direction": "lower-is-better",
      "description": "Engineering effort in person-weeks"
    }
  ],
  "scorers": [
    {
